# Tokens for bloaty's option parser and -c config language.  Deliberately no
# "--version" (it exit(0)s the process) and no "--help"/"--list-sources" (they
# end option parsing without running a scan).
f1="--csv"
f2="--tsv"
f3="--raw-map"
o1="-c"
o2="-d"
o3="-C"
o4="--demangle"
o5="--debug-file"
o6="--dsym"
o7="--debug-fileoff"
o8="--debug-vmaddr"
o9="--disassemble"
o10="-n"
o11="--domain"
o12="-s"
o13="--source-filter"
o14="--source-map"
o15="-v"
o16="-vv"
o17="-vvv"
o18="-w"
v1="symbols"
v2="sections"
v3="segments"
v4="compileunits"
v5="inlines"
v6="armembers"
v7="archs"
v8="inputfiles"
v9="rawsymbols"
v10="fullsymbols"
v11="shortsymbols"
v12="vm"
v13="file"
v14="both"
v15="full"
v16="short"
v17="none"
v18="0"
v19="5"
v20="1"
# protobuf TextFormat config language
c1="custom_data_source"
c2="base_data_source"
c3="rewrite"
c4="pattern"
c5="replacement"
c6="data_source"
c7="max_rows_per_level"
c8="verbose_level"
c9="source_filter"
c10="demangle"
c11="sort_by"
c12="filename"
s1="^_"
s2=".*"
s3="fn"
